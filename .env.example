# Your domain names (used in Traefik labels)
COUCHDB_HOST=couchdb.yourdomain.com
MCP_HOST=obsidian-mcp.yourdomain.com

# CouchDB server admin (devices sync with it; the services below never use it)
COUCHDB_USER=admin
COUCHDB_PASSWORD=changeme

# obsidian-mcp bearer token (must match what you configure in Claude's MCP settings)
SEMANTIC_BEARER=changeme

# JWT secret for the obsidian-mcp OAuth flow
JWT_SECRET=changeme

# Password shown on the OAuth consent screen
AUTHORIZE_PASSWORD=changeme

# Obsidian Local REST API key (copy from plugin settings after first boot)
OBSIDIAN_API_KEY=placeholder

# Non-admin members of the obsidian database (create them in CouchDB's _users and
# add both names to obsidian/_security members). obsidian-mcp writes notes as the
# writer; obsidian-vault-mirror reads as the reader and never writes.
VAULT_WRITER_USER=vault-writer
VAULT_WRITER_PASSWORD=changeme
VAULT_READER_USER=vault-reader
VAULT_READER_PASSWORD=changeme
